# Copy to backend/.env for running against your own Postgres (`npm run dev`).
# Not needed for `npm run dev:local` or for the tests, which use a
# throwaway local database and never read this file.

# Postgres connection string. A local server connects without SSL; any
# other host must present a valid certificate.
DATABASE_URL=postgresql://user:password@localhost:5432/onyx_vault

# A long random string used to sign session cookies.
JWT_SECRET=replace_with_a_long_random_string

NODE_ENV=development
PORT=4000

# The frontend's address, used in links inside emails.
CLIENT_ORIGIN=http://localhost:5173

# Comma-separated origins allowed to make requests (defaults to the local
# Vite servers outside production; required in production).
ALLOWED_ORIGINS=http://localhost:5173

# Transactional email via Brevo's HTTPS API (required outside tests).
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_SENDER_EMAIL=you@example.com

# Whether new people can create real accounts (default true). The live
# site runs with this set to false; the demo is always available.
PUBLIC_SIGNUP_ENABLED=true

# Most demo accounts that may exist at once (default 50).
MAX_LIVE_DEMOS=50
